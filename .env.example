# LALA-next local development configuration.
# Copy to .env and fill values locally. Do not commit real secret values.
# Dotenv loading is permitted only when this explicit local profile is set.
LALA_RUNTIME_PROFILE=local
LALA_LOCAL_USE_AWS_SECRETS=false

IOS_API_KEY=
API_BEARER_TOKEN=
LALA_PUBLIC_CONTEST_ACCESS=false
LALA_GUEST_ACCESS=false
LALA_SMOKE_BEARER_TOKEN=
LALA_SMOKE_API_KEY=
# Canonical Logto settings. With an HTTPS base endpoint, issuer and JWKS derive as
# <endpoint>/oidc and <endpoint>/oidc/jwks. OAUTH_* remains a compatibility fallback.
LOGTO_ENDPOINT=
LOGTO_API_AUDIENCE=
# Flutter public clients. These values are compile-time dart-defines, not secrets.
LOGTO_NATIVE_APP_ID=
LOGTO_WEB_APP_ID=
LOGTO_REDIRECT_URI=
LOGTO_POST_LOGOUT_REDIRECT_URI=
# Management credentials are used only for local account deletion.
LOGTO_MANAGEMENT_ENDPOINT=
LOGTO_MANAGEMENT_CLIENT_ID=
LOGTO_MANAGEMENT_CLIENT_SECRET=
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URL=
OAUTH_CLIENT_ID=
OAUTH_REQUIRED_SCOPES=
KAKAO_REST_API_KEY=
# Domain-restricted client build configuration. Store separately from runtime
# credentials in AWS Secrets Manager as lala-next/kakao-javascript-key when
# team build access is required.
KAKAO_JAVASCRIPT_KEY=
KAKAO_REDIRECT_URI=https://api.lala-next.cloud/auth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KOPIS_API_KEY=
PUBLIC_DATA_SERVICE_KEY=
GYEONGGI_DATA_DREAM_API_KEY=
DB_DSN=
LALA_POSTGRES_USER=lala
LALA_POSTGRES_PASSWORD=
LALA_POSTGRES_DB=lala
LALA_POSTGRES_PORT=55432
KEY_VAULT_URL=
LALA_ALLOWED_KEY_VAULT_HOSTS=
# General OpenAI only. Azure OpenAI endpoints are deliberately rejected.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Canonical non-secret role model overrides. These take precedence over the
# legacy OPENAI_*_MODEL compatibility inputs below and contain model IDs only.
# review_bulk: high-volume extraction, ad classification, and mention normalization.
LALA_MODEL_ROLE_REVIEW_BULK=gpt-5.4-nano
# review_recheck: selective low-confidence review recheck.
LALA_MODEL_ROLE_REVIEW_RECHECK=gpt-5.4-mini
# docent: live docent script/reason generation.
LALA_MODEL_ROLE_DOCENT=gpt-5.4-mini
# docent_qa: reserved for the future W3-f LLM judge; current QA is deterministic.
LALA_MODEL_ROLE_DOCENT_QA=gpt-5.4-mini
# place_enrichment: structured English/indoor place enrichment.
LALA_MODEL_ROLE_PLACE_ENRICHMENT=gpt-5.4-mini
# embedding: semantic chunk/query embeddings.
LALA_MODEL_ROLE_EMBEDDING=text-embedding-3-small

# Legacy compatibility inputs. Keep these for existing deployments; canonical
# LALA_MODEL_ROLE_* values above win when both are present.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REVIEW_BATCH_MODEL=gpt-5.4-nano
OPENAI_REVIEW_RECHECK_MODEL=gpt-5.4-mini
OPENAI_DOCENT_MODEL=gpt-5.4-mini
OPENAI_PLACE_ENRICHMENT_MODEL=gpt-5.4-mini
LALA_ENABLE_LIVE_AI=false
AZURE_SPEECH_REGION=koreacentral
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
LALA_ENABLE_LIVE_SPEECH=false
CORS_ALLOW_ORIGINS=
LOG_LEVEL=INFO
LALA_ACCESS_LOG_PATH=
