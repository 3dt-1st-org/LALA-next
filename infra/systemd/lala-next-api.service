[Unit]
Description=LALA-next API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/lala-next
Environment=LALA_RUNTIME_PROFILE=api
Environment=LALA_PUBLIC_CONTEST_ACCESS=true
Environment=LALA_STATIC_SNAPSHOT_FALLBACK=false
ExecStart=/opt/lala-next/scripts/unix/start_api.sh --runtime-profile api --port 8000 --enable-live-ai
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
